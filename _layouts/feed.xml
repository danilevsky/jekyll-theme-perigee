{%- assign pg_f_lang = page.lang | default: site.default_lang -%}
{%- assign pg_f_posts = site.posts | where: "lang", pg_f_lang -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.title | xml_escape }}</title>
  <description>{{ site.description | xml_escape }}</description>
  <link>{{ site.url }}{{ site.baseurl }}/</link>
  <atom:link href="{{ page.url | absolute_url }}" rel="self" type="application/rss+xml" />
  <language>{{ pg_f_lang }}</language>
  <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
  {%- for pg_post in pg_f_posts limit: 20 %}
  <item>
    <title>{{ pg_post.title | xml_escape }}</title>
    <description>{{ pg_post.content | strip_html | normalize_whitespace | truncate: 300 | xml_escape }}</description>
    <link>{{ pg_post.url | absolute_url }}</link>
    <guid isPermaLink="true">{{ pg_post.url | absolute_url }}</guid>
    <pubDate>{{ pg_post.date | date_to_rfc822 }}</pubDate>
    {%- for pg_tag in pg_post.tags %}<category>{{ pg_tag | xml_escape }}</category>{% endfor %}
  </item>
  {%- endfor %}
</channel>
</rss>
